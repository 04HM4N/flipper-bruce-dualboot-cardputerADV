# Dual-boot additions for the Bruce firmware (Cardputer):
# - FlipperOsMenu.{h,cpp}: 'Switch to Flipper Port' (ota_0) via otadata erase
# - ConfigMenu/OthersMenu: menu entries
# - sd_functions.cpp: self-healing LittleFS mount (format on first boot)
# Generated from the Bruce checkout; applied by patchBruce.py.

diff --git a/src/core/FlipperOsMenu.cpp b/src/core/FlipperOsMenu.cpp
new file mode 100644
index 0000000..96c36dd
--- /dev/null
+++ b/src/core/FlipperOsMenu.cpp
@@ -0,0 +1,62 @@
+// --- Dual-boot add-on (not part of upstream Bruce) ---------------------------
+// "Switch to Flipper Port": reboots the device into the ElicoftZ Flipper Zero
+// port that lives in the ota_0 partition (this firmware lives in ota_1).
+// Mirrors the "Switch to Bruce Firmware" entry in the Flipper port's lock
+// menu. Created by patchBruce.py / tools/bruce_cardputer_dualboot.patch in
+// the Flipper repo.
+#include "FlipperOsMenu.h"
+
+#include "core/display.h"
+#include "core/utils.h"
+
+#include <esp_ota_ops.h>
+#include <esp_partition.h>
+#include <esp_system.h>
+
+// The Flipper Zero port lives in the ota_0 slot; this firmware runs from ota_1.
+#define FLIPPEROS_TARGET_SUBTYPE ESP_PARTITION_SUBTYPE_APP_OTA_0
+
+bool switch_to_flipper_available() {
+    // The switch works by clearing the OTA selection (otadata), which makes
+    // the bootloader fall back to ota_0 (Flipper port) — so only the presence
+    // of an otadata partition is required. esp_ota_set_boot_partition() is NOT
+    // used: the Flipper bootloader computes the otadata CRC with a variant
+    // (crc32 init=0) that Bruce's Arduino-core ESP-IDF libs don't reproduce,
+    // so entries written from Bruce are rejected and the bootloader keeps
+    // booting the other (still valid) slot — i.e. this firmware again.
+    const esp_partition_t *otadata = esp_partition_find_first(
+        ESP_PARTITION_TYPE_DATA, ESP_PARTITION_SUBTYPE_DATA_OTA, NULL);
+    return otadata != NULL;
+}
+
+void switch_to_flipper() {
+    const esp_partition_t *otadata = esp_partition_find_first(
+        ESP_PARTITION_TYPE_DATA, ESP_PARTITION_SUBTYPE_DATA_OTA, NULL);
+    if (otadata == NULL) {
+        displayError("No OTA data partition.\nNot a dual-boot image.", true);
+        return;
+    }
+    // Erase BOTH otadata sectors. With no valid OTA selection the bootloader
+    // boots ota_0 (Flipper port) by default; it then rewrites otadata itself.
+    esp_err_t err = esp_partition_erase_range(otadata, 0, otadata->size);
+    if (err != ESP_OK) {
+        displayError("Could not clear\nthe OTA selection.", true);
+        return;
+    }
+    displayInfo("Rebooting to Flipper...");
+    delay(150);
+    esp_restart();
+}
+
+void flipperOsOptionsMenu() {
+    if (!switch_to_flipper_available()) {
+        displayError("No Flipper firmware\nin ota_0 slot.", true);
+        return;
+    }
+    options = {
+        {"Switch to Flipper Port", switch_to_flipper},
+        {"Cancel",                 []() {}          },
+    };
+    addOptionToMainMenu();
+    loopOptions(options, MENU_TYPE_SUBMENU, "Flipper Zero");
+}
