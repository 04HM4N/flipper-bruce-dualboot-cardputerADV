diff --git a/src/core/sd_functions.cpp b/src/core/sd_functions.cpp
index 5e92dba..e5ba1e9 100644
--- a/src/core/sd_functions.cpp
+++ b/src/core/sd_functions.cpp
@@ -32,6 +32,19 @@ std::vector<FileList> fileList;
 ***************************************************************************************/
 bool setupLittleFS(uint8_t maxFiles) {
     if (maxFiles < 1) { maxFiles = 1; }
+    if (LittleFS.begin(false, "/littlefs", maxFiles)) return true;
+    // The spiffs partition is freshly erased (first boot after a dual-boot flash
+    // with --erase-all) or the filesystem is corrupt: format it and retry so the
+    // first boot works without a manual reset. Nothing unmounts LittleFS at
+    // runtime, so this only ever triggers at boot time.
+    Serial.println("LittleFS mount failed, formatting spiffs partition...");
+    LittleFS.format();
+    delay(50);
+    if (LittleFS.begin(false, "/littlefs", maxFiles)) return true;
+    // Formatting a brand-new erased partition sometimes needs a second pass.
+    Serial.println("LittleFS format retry...");
+    LittleFS.format();
+    delay(50);
     return LittleFS.begin(false, "/littlefs", maxFiles);
 }
 
