+// --- Dual-boot add-on (not part of upstream Bruce) ---------------------------
+// Provides the "Switch to Flipper Port" entries (Config + Others menus) that
+// reboot the device into the ElicoftZ Flipper Zero port living in the ota_0
+// partition (this firmware lives in ota_1). Mirrors the "Switch to Bruce
+// Firmware" entry in the Flipper port's lock menu.
+// These files are created by patchBruce.py /
+// tools/bruce_cardputer_dualboot.patch in the Flipper repo.
+#ifndef __FLIPPEROS_MENU_H__
+#define __FLIPPEROS_MENU_H__
+
+// True when an ota_0 partition exists AND contains a flashed app image.
+bool switch_to_flipper_available();
+
+// Point the OTA boot slot at ota_0 and reboot into the Flipper port.
+void switch_to_flipper();
+
+// Confirmation submenu ("Switch to Flipper Port" / "Cancel").
+void flipperOsOptionsMenu();
+
+#endif // __FLIPPEROS_MENU_H__
